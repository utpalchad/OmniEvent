# Frontend API base. Use the deployed API URL outside local development.
VITE_API_URL=http://localhost:8000

# Public PayPal Sandbox client ID exposed to the browser.
VITE_PAYPAL_CLIENT_ID=

# Server-only PayPal credentials. Never prefix the secret with VITE_.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173